<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Conectores (v1.7): sueño desde Health Connect (solo lectura) y estimación con el uso del teléfono. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- Para ver si Namida, Spotify, YouTube Music y Health Connect están instalados y para leer la carátula que comparte Namida. -->
    <queries>
        <package android:name="com.msob7y.namida" />
        <package android:name="com.msob7y.namida.debug" />
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.namstat.player" />
        <provider android:authorities="com.namstat.player.tat" />
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".FitstatApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_lavanda"
        android:roundIcon="@mipmap/ic_launcher_lavanda"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fitstat">

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize" />

        <!-- Un alias por color de ícono: solo uno está activo a la vez (Ajustes › Ícono de la app). -->
        <activity-alias
            android:name=".IconLavanda"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_lavanda"
            android:roundIcon="@mipmap/ic_launcher_lavanda"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconMenta"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_menta"
            android:roundIcon="@mipmap/ic_launcher_menta"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconMandarina"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mandarina"
            android:roundIcon="@mipmap/ic_launcher_mandarina"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconRosa"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_rosa"
            android:roundIcon="@mipmap/ic_launcher_rosa"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconAzul"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_azul"
            android:roundIcon="@mipmap/ic_launcher_azul"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconLima"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_lima"
            android:roundIcon="@mipmap/ic_launcher_lima"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconFuego"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_fuego"
            android:roundIcon="@mipmap/ic_launcher_fuego"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconAmbar"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ambar"
            android:roundIcon="@mipmap/ic_launcher_ambar"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconTurquesa"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_turquesa"
            android:roundIcon="@mipmap/ic_launcher_turquesa"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconMono"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mono"
            android:roundIcon="@mipmap/ic_launcher_mono"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconCarmesi"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_carmesi"
            android:roundIcon="@mipmap/ic_launcher_carmesi"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconAcero"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_acero"
            android:roundIcon="@mipmap/ic_launcher_acero"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- Health Connect pide una pantalla que explique para qué se leen los datos (Android 13 y anteriores, y Android 14 o más). -->
        <activity-alias
            android:name=".HealthRationale"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ViewPermissionUsage"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Existe solo para que Android deje a FITSTAT ver qué reproduce Namida (no lee notificaciones). -->
        <service
            android:name=".conn.FitstatListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver android:name=".sys.ReminderReceiver" android:exported="false" />

        <receiver android:name=".sys.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".sys.WidgetToday"
            android:exported="true"
            android:label="@string/widget_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today" />
        </receiver>
        <receiver
            android:name=".sys.WidgetBot"
            android:exported="true"
            android:label="@string/widget_bot">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_bot" />
        </receiver>
        <receiver
            android:name=".sys.WidgetWeek"
            android:exported="true"
            android:label="@string/widget_week">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_week" />
        </receiver>
        <receiver
            android:name=".sys.WidgetRecords"
            android:exported="true"
            android:label="@string/widget_records">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_records" />
        </receiver>
    </application>
</manifest>
